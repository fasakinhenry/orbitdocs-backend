NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/orbitdocs

# Frontend origin allowed by CORS and used for cookies (no trailing slash)
CLIENT_URL=http://localhost:5173

# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-random-characters

# File storage. Any S3 compatible provider works. Keep the bucket PRIVATE.
# STORAGE_PROVIDER: b2 (Backblaze B2), s3 (AWS S3), r2 (Cloudflare R2), custom (Wasabi, MinIO, DigitalOcean Spaces, ...)
STORAGE_PROVIDER=b2
# Needed for b2 and s3. Backblaze example: us-west-004 (the middle part of your S3 endpoint)
STORAGE_REGION=us-west-004
# Needed for r2 and custom. Optional override for b2. Leave empty for AWS S3.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=your-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
STORAGE_BUCKET=your-private-bucket-name

# The only account that can use the platform admin routes. Everyone else gets a 404.
# The account must be registered with this exact email and have it verified.
ADMIN_EMAIL=fasakinhenry@gmail.com

# Resend (transactional email). MAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=OrbitDocs <invites@yourdomain.com>
